{
  "name": "pi-proxy-gateway",
  "version": "0.3.1",
  "description": "use the models pi can reach, with API keys or OAuth logins, from any OpenAI- or Anthropic-compatible app.",
  "type": "module",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npx -p typescript tsc --noEmit --esModuleInterop --moduleResolution bundler --module esnext --target esnext --skipLibCheck index.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai-compatible",
    "anthropic-compatible",
    "llm-proxy",
    "chatgpt",
    "codex",
    "claude",
    "open-webui"
  ],
  "author": "cairo d'avila",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairodavila/pi-proxy-gateway.git"
  },
  "homepage": "https://github.com/cairodavila/pi-proxy-gateway#readme",
  "bugs": {
    "url": "https://github.com/cairodavila/pi-proxy-gateway/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
